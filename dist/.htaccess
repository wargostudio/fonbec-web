# ============================================================================
# .htaccess for premium static websites — copy as `.htaccess` to project root.
# Targets Apache (Hostinger default) and LiteSpeed.
# ============================================================================
#
# What this does:
# - HTML / JS / CSS / JSON: revalidate every visit (no stale code after deploy).
# - Images / fonts: cache 1 month (they change rarely; rename if needed).
# - MIME types: ensures Hostinger serves WebP and JS correctly.
# - Compression: gzip text assets when supported.
# - Security headers: minimal hardening.
#
# Doesn't work on Nginx VPS — those need server-level config.

# ----- Cache duration -----
<IfModule mod_expires.c>
  ExpiresActive On

  # Documents — never cache
  ExpiresByType text/html "access plus 0 seconds"

  # Code — revalidate hourly (server still responds 304 if unchanged)
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType text/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"

  # Media — cache long (use cache-busting filename if you change them)
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Fonts — cache long, immutable
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ----- Cache-Control headers -----
<IfModule mod_headers.c>
  # HTML always fresh
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # JS / CSS / JSON: revalidate every visit
  <FilesMatch "\.(css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images & fonts: long cache
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Minimal security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----- Correct MIME types (some shared hosts default wrong) -----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

# ----- Gzip compression for text assets -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>


ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si el hosting publica la raíz del repositorio (Hostinger + Git), la raíz reenvía aquí
  # internamente. Si alguien pide /dist/... directamente, lo llevamos a la URL limpia.
  RewriteCond %{THE_REQUEST} ^\S+\s/dist/(\S*)\s
  RewriteRule ^ /%1 [R=301,L,NE]

  # Dominio sin www → www (solo para el dominio oficial)
  RewriteCond %{HTTP_HOST} ^fonbec\.org\.ar$ [NC]
  RewriteRule ^(.*)$ https://www.fonbec.org.ar/$1 [R=301,L]

  # HTTPS manteniendo el dominio que se esté usando (también dominios temporales de Hostinger)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Redirecciones desde el sitio WordPress anterior
  RewriteCond %{QUERY_STRING} (^|&)page_id=10(&|$)
  RewriteRule ^(index\.php)?$ /quienes-somos/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=12(&|$)
  RewriteRule ^(index\.php)?$ /quienes-somos/#pilares [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=14(&|$)
  RewriteRule ^(index\.php)?$ /que-hacemos/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=18(&|$)
  RewriteRule ^(index\.php)?$ /colaborar/#amigos [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=20(&|$)
  RewriteRule ^(index\.php)?$ /impacto/#transparencia [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=22(&|$)
  RewriteRule ^(index\.php)?$ /impacto/#empresas [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=25(&|$)
  RewriteRule ^(index\.php)?$ /colaborar/#apadrinar [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=27(&|$)
  RewriteRule ^(index\.php)?$ /impacto/#empresas [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=29(&|$)
  RewriteRule ^(index\.php)?$ /contacto/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=92(&|$)
  RewriteRule ^(index\.php)?$ /historias/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=149(&|$)
  RewriteRule ^(index\.php)?$ /colaborar/#apadrinar [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=160(&|$)
  RewriteRule ^(index\.php)?$ /contacto/#filiales [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=197(&|$)
  RewriteRule ^(index\.php)?$ /colaborar/#voluntariado [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=243(&|$)
  RewriteRule ^(index\.php)?$ /colaborar/#apadrinar [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=533(&|$)
  RewriteRule ^(index\.php)?$ /quienes-somos/#red [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=1771(&|$)
  RewriteRule ^(index\.php)?$ /quienes-somos/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=2003(&|$)
  RewriteRule ^(index\.php)?$ /quienes-somos/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=2055(&|$)
  RewriteRule ^(index\.php)?$ /historias/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=2056(&|$)
  RewriteRule ^(index\.php)?$ /historias/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)page_id=2128(&|$)
  RewriteRule ^(index\.php)?$ /colaborar/#becarios [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)p=1643(&|$)
  RewriteRule ^(index\.php)?$ /historias/#maria-cristina [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?una-maestra-que-vale-un-millon/?$ /historias/#maria-cristina [R=301,L,NE]
