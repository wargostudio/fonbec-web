  RewriteRule ^(index\.php)?$ /historias/#mauro [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?encuentro-total-filial-fonbec-bs-as/?$ /historias/#mauro [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=1499(&|$)
  RewriteRule ^(index\.php)?$ /impacto/#prensa [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?el-diario-del-centro-ayuda-que-abre-puertas-y-da-esperanzas/?$ /impacto/#prensa [R=301,L,NE]
