  RewriteRule ^(index\.php/)?historia-de-final-feliz/?$ /historias/#santos [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=884(&|$)
  RewriteRule ^(index\.php)?$ /historia/#y2014 [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?garayoa-joven-sobresaliente/?$ /historia/#y2014 [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=595(&|$)
  RewriteRule ^(index\.php)?$ /historias/#sergio [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?predicando-con-el-ejemplo/?$ /historias/#sergio [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=521(&|$)
  RewriteRule ^(index\.php)?$ /historias/#catherina [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?de-ahijada-a-madrina-2/?$ /historias/#catherina [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=497(&|$)
  RewriteRule ^(index\.php)?$ /historias/#voluntarios-michigan [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?10-semanas-en-fonbec-2/?$ /historias/#voluntarios-michigan [R=301,L,NE]
