  RewriteRule ^(index\.php)?$ /historia/#y2018 [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?bodegas-abiertas-a-beneficio-de-fonbec-mendoza/?$ /historia/#y2018 [R=301,L,NE]
