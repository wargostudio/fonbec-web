  RewriteRule ^(index\.php)?$ /historias/#ezequiel [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?ezequiel-caceres-becario-de-fonbec-mendoza-fue-seleccionado-por-la-embajada-de-estados-unidos/?$ /historias/#ezequiel [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=395(&|$)
  RewriteRule ^(index\.php)?$ /historia/#y2013 [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?fonbec-miembro-de-la-federacion-el-foro-del-sector-social-2/?$ /historia/#y2013 [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=323(&|$)
  RewriteRule ^(index\.php)?$ /historia/#y2012 [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?el-premio-al-esfuerzo-educativo/?$ /historia/#y2012 [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=260(&|$)
  RewriteRule ^(index\.php)?$ /historias/#ezequiel [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?jovenes-embajadores-2012/?$ /historias/#ezequiel [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=232(&|$)
  RewriteRule ^(index\.php)?$ /historias/#lectura [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?a-leer/?$ /historias/#lectura [R=301,L,NE]
  RewriteCond %{QUERY_STRING} (^|&)p=220(&|$)
  RewriteRule ^(index\.php)?$ /historias/#deportistas [R=301,L,NE,QSD]
  RewriteRule ^(index\.php/)?deportistas/?$ /historias/#deportistas [R=301,L,NE]
  RewriteRule ^novedades(/.*)?$ /historias/ [R=301,L]

  # Contenido spam inyectado en el sitio anterior y rutas de WordPress: 410 (eliminado definitivamente)
  RewriteCond %{QUERY_STRING} (^|&)(p|cat|feed|page_id|rest_route|s)= [NC]
  RewriteRule ^(index\.php)?$ - [G,L]
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json|xmlrpc\.php|wp-login\.php|feed)(/.*)?$ - [G,L]
</IfModule>
